<resources>
    <style name="Theme.Mando" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#D9B77E</item>
        <item name="colorPrimaryDark">#0C0C0E</item>
        <item name="colorAccent">#D9B77E</item>
        <item name="android:windowBackground">#FF0C0C0E</item>
        <item name="android:statusBarColor">#FF0C0C0E</item>
        <item name="android:navigationBarColor">#FF0C0C0E</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
    </style>
    <style name="Theme.Mando.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>
</resources>
